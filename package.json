{
  "name": "cybersaarthi-module2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "python -m uvicorn app.main:app --app-dir cerberus1 --host 127.0.0.1 --port 8000 --reload",
    "seed": "python -c \"import sys; sys.path.insert(0, 'cerberus1'); from app.db.session import SessionLocal; from app.services.seed_service import seed_synthetic_data; db=SessionLocal(); seed_synthetic_data(db); db.close()\"",
    "dev:all": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run backend\" \"npm run dev\"",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },

  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
