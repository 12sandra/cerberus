# Environment Configuration for CyberSaarthi Module 1 Backend
PROJECT_NAME="CyberSaarthi Module 1 - Data Intelligence Backend"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL or SQLite fallback)
# DATABASE_URL=postgresql://cybersaarthi:cybersaarthi_secure_pass@localhost:5433/cybersaarthi
DATABASE_URL=sqlite:///./data/cybersaarthi.db

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cybersaarthi_graph_pass
NEO4J_ENABLED=true

# Security
SECRET_KEY=cybersaarthi_dev_secret_key_2026_super_secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_DIR=./data/uploads

# Pluggable AI / NLP / OCR
AI_PROVIDER=heuristic # "heuristic", "openai", "gemini"
AI_API_KEY=
OCR_ENGINE=auto # "auto", "pdfplumber", "easyocr", "tesseract"
